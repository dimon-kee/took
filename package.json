{
  "name": "took",
  "version": "0.1.6",
  "description": "截图 / 录屏工具",
  "main": "src/main/index.js",
  "author": "dimonkyk",
  "license": "MIT",
  "scripts": {
    "postinstall": "node tools/make-icons.js && node tools/fetch-ocr-models.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "node tools/collect-vcruntime.js && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "gifenc": "^1.0.3",
    "jsqr": "^1.4.0",
    "koffi": "^3.3.1",
    "onnxruntime-node": "^1.30.0"
  },
  "build": {
    "appId": "ai.xtractify.took",
    "productName": "Took",
    "publish": [
      {
        "provider": "github",
        "owner": "dimon-kee",
        "repo": "took"
      }
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/jsqr/**/*",
      "node_modules/gifenc/**/*",
      "node_modules/koffi/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/{darwin,linux}{,/**/*}",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64{,/**/*}",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/{DirectML,dxcompiler,dxil}.dll",
      "!node_modules/onnxruntime-node/{lib,script}{,/**/*}",
      "!node_modules/onnxruntime-common/{lib,dist/esm}{,/**/*}",
      "!node_modules/onnxruntime-{node,common}/**/*.{map,ts}"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*",
      "node_modules/onnxruntime-node/**/*",
      "assets/ocr/**/*"
    ],
    "extraResources": [
      {
        "from": "build/vcruntime",
        "to": "app.asar.unpacked/node_modules/onnxruntime-node/bin/napi-v6/win32/x64",
        "filter": [
          "*.dll"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
